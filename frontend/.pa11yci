{
  "defaults": {
    "concurrency": 4,
    "standard": "WCAG2AA",
    "runners": [
      "axe"
    ]
  },
  "urls": [
    {
      "url": "http://localhost/login"
    },
    {
      "actions": [
        "click element .mt-3 a",
        "set field #formBasicEmail to juliar",
        "set field #formBasicPassword to password",
        "click element button[type=submit]",
        "wait for url to be http://localhost/trackExercise"
      ],
      "url": "http://localhost/trackExercise"
    },
    {
      "actions": [
        "click element #basic-navbar-nav > div > div > a:nth-child(2)"
      ],
      "url": "http://localhost/statistics"
    }
  ]
}
